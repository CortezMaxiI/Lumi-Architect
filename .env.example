# Lumi: Architect - Environment Configuration
# ============================================
# Copy this file to .env and configure your keys.
# If no keys are provided, Lumi runs in demo/offline mode automatically.

# LLM Provider Configuration
# Supported providers: "gemini", "openai", "local"
LLM_PROVIDER=gemini

# Google Gemini Configuration
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI / Compatible API Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1 # For Ollama or local LLMs

# Execution Settings
LUMI_DRY_RUN=false
LUMI_SKIP_ADMIN_CHECK=false
